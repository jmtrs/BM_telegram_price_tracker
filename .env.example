TELEGRAM_TOKEN="your_telegram_bot_token"
SCRAPERAPI_KEY="your_scraperapi_key"
DATABASE_URL="postgresql://username:password@host:port/database"

# Logto OIDC variables (for API token validation)
LOGTO_ISSUER="https://your-logto-domain.logto.app/oidc"
LOGTO_AUDIENCE="http://localhost:8000/api" # Or your production API audience
LOGTO_JWKS_URI="https://your-logto-domain.logto.app/oidc/jwks"

# Logto SDK variables (for web authentication flow, e.g., sign-in page)
LOGTO_ENDPOINT="https://your-logto-domain.logto.app/"
LOGTO_APP_ID="your_logto_app_id"
LOGTO_APP_SECRET="your_logto_app_secret"

# Session secret key for Logto SDK (and potentially other session management)
SESSION_SECRET_KEY="a_very_strong_and_random_secret_key" # e.g., openssl rand -hex 32

# Optional: Scraper settings
# SCRAPE_TTL_MINUTES=60 # Time in minutes to cache scraped prices
# CHECK_INTERVAL_SECONDS=300 # How often the checker runs to find price drops
# NOTIFICATION_COOLDOWN_MINUTES=1440 # Cooldown in minutes before re-notifying for the same alert (24 hours)
